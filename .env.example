# 原型极速分享平台 —— 环境变量样例
#
# 用法：复制为 .env 并填入真实值
#     cp .env.example .env
#
# .env 已在 .gitignore 排除范围内，不会进版本库。
# 真实环境变量优先于本文件，因此临时覆盖可以直接 export 而不改文件。
# 本文件里的凭据字段一律是占位符，不要在这里填真实的 Secret。

# ── 部署环境 ────────────────────────────────────────────────────────────────
# development | production
# production 会给会话 Cookie 加上 Secure 属性，并把 http 开发回调地址
# 从允许列表中排除。
DEPLOY_ENV=development

# ── 身份解析模式 ────────────────────────────────────────────────────────────
# embedded — 单进程直连（本机开发）。身份只从会话 Cookie 解析，
#            所有客户端传入的 X-Auth-* 请求头一律剥离并忽略。
# gateway  — Nginx 在前面做 auth_request，并注入 X-Auth-* 头。
#            仅当来源地址在 TRUSTED_GATEWAY_IPS 内时才采信这些头。
# 留空或写错都会被当作 embedded（取值非法时直接拒绝启动），
# 这样配置失误的后果是「登不进去」而不是「谁都能冒充别人」。
AUTH_MODE=embedded

# gateway 模式下允许注入身份头的对端地址，逗号分隔
TRUSTED_GATEWAY_IPS=127.0.0.1,::1

# ── 对外地址 ────────────────────────────────────────────────────────────────
# embedded 模式下可留空（回退到请求自身的来源）。
# gateway 模式下两项必填：管理界面与 API 在 ADMIN_ORIGIN，
# 原型内容在 PREVIEW_ORIGIN，两个域各自独立会话，防止上传的 HTML 偷凭据。
ADMIN_ORIGIN=
PREVIEW_ORIGIN=
# 生产环境示例：
# ADMIN_ORIGIN=https://app.example.com
# PREVIEW_ORIGIN=https://preview.example.com

# ── 飞书企业自建应用 ────────────────────────────────────────────────────────
# 在 open.feishu.cn 的「凭证与基础信息」里获取。
# App Secret 只放这里（或真实环境变量），不要写进代码、日志或前端。
FEISHU_APP_ID=cli_xxxxxxxxxxxxxxxx
FEISHU_APP_SECRET=REPLACE_WITH_YOUR_APP_SECRET

# ── 签名密钥 ────────────────────────────────────────────────────────────────
# 用于跳转凭证与项目访问凭证的 HMAC 签名。
# embedded 模式下留空会自动生成并持久化到 .auth_secret（重启后已签发凭证仍有效）。
# gateway 模式下必须显式设置，否则拒绝启动。
# 生成方式：python3 -c "import secrets; print(secrets.token_urlsafe(32))"
AUTH_SIGNING_SECRET=

# ── 应急管理员通道 ──────────────────────────────────────────────────────────
# 飞书故障、应用被误停用、权限被撤销时的兜底登录入口。
# 监听地址必须是回环地址，配成其它地址会直接拒绝启动整个进程。
EMERGENCY_ENABLED=true
EMERGENCY_BIND=127.0.0.1:8099

# ── 预览内容沙箱（仅 embedded 模式生效）────────────────────────────────────
# 给 /files /protected /versions 的响应加 CSP sandbox，
# 使上传的原型页面读不到管理界面的 Cookie 与 localStorage。
# 代价：依赖 localStorage 或同源 fetch 的原型会失效。
# 关掉等于恢复到接入 SSO 之前的风险水平。
PREVIEW_SANDBOX=true
