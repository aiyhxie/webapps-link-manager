# Dependencies
frontend/node_modules/
frontend/dist/

# Python
__pycache__/
*.pyc
*.pyo

# User data (exclude uploaded files and runtime data)
webapps/
versions/
logs/
metadata.json
version_iteration.json
归档.zip

# IDE
.vscode/
.idea/
*.swp
*.swo

# macOS
.DS_Store

# Build artifacts
*.egg-info/
dist/
build/

# Local secrets / env files (never commit)
.env
.env.*
# ...but the placeholder template must be in the repo so new deployments know
# which variables to set (it contains no real credentials).
!.env.example

# HMAC signing key auto-generated in embedded mode (see server/auth/signing.py)
.auth_secret

# Isolated work-in-progress that hasn't been reviewed/tested
_wip_*/

# Runtime lock files and auto-backup snapshots for metadata.json/changelog.json
# (generated by atomic_store.py; may contain historical copies of admin
# password hashes and other sensitive data, and are purely local/runtime)
.*.lock
.metadata_backups/
.changelog_backups/

# Auth session store (live sessions, OAuth states, handoff credentials) and its
# backups — runtime state, never committed
auth_sessions.json
.auth_sessions_backups/
metadata.pre-identity-*.json
